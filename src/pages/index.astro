---
const projects = [
  {
    name: 'Open Source Directory',
    slug: 'opensource-directory',
    description: 'El punto de encuentro para descubrir todo lo que construimos en abierto.',
    category: 'Web',
    language: 'Astro',
    status: 'En desarrollo',
    href: 'https://github.com/Mate-Logic/opensource-directory',
    featured: true,
  },
];

const categories = ['Todos', 'Web', 'Herramientas', 'CLI', 'Librerías'];
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Directorio de proyectos open source creados por MateLogic." />
    <meta name="theme-color" content="#10110f" />
    <title>MateLogic Open Source</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={base} aria-label="MateLogic Open Source, inicio">OpenSource <span>/ MateLogic</span></a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a class="github-link" href="https://github.com/Mate-Logic" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="pulse"></span> Proyectos open source de MateLogic</p>
            <h1 id="hero-title">Software abierto.<br /><em>Ideas compartidas.</em></h1>
            <p class="hero-text">Un espacio simple para explorar las herramientas y proyectos que construimos en público.</p>
          </div>
        </section>

        <section class="directory" id="proyectos" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <p class="section-kicker">01 / El directorio</p>
              <h2 id="projects-title">Nuestros proyectos</h2>
            </div>
            <p class="project-count"><span>{projects.length.toString().padStart(2, '0')}</span> proyectos publicados</p>
          </div>

          <div class="toolbar">
            <div class="filters" aria-label="Filtrar proyectos">
              {categories.map((category, index) => <button class:list-active={index === 0} data-filter={category}>{category}</button>)}
            </div>
            <label class="search-box">
              <span class="search-icon" aria-hidden="true">⌕</span>
              <span class="sr-only">Buscar proyectos</span>
              <input type="search" placeholder="Buscar proyecto..." id="project-search" />
              <kbd>/</kbd>
            </label>
          </div>

          <div class="project-grid" id="project-grid">
            {projects.map((project) => (
              <article class:list-featured={project.featured} class="project-card" data-category={project.category} data-name={project.name.toLowerCase()}>
                <div class="card-topline"><span class="project-icon">{project.name.slice(0, 1)}</span><span class="status"><i></i>{project.status}</span></div>
                <div class="card-content">
                  <p class="card-category">{project.category} <span>/</span> {project.language}</p>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
                <div class="card-footer">
                  <span class="repo-slug">Mate-Logic / {project.slug}</span>
                  <a href={project.href} target="_blank" rel="noreferrer" aria-label={`Ver ${project.name} en GitHub`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6-.03c2.3-1.56 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.9 1.23 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"/></svg> Ver en GitHub <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
            <article class="coming-card">
              <span class="plus-icon">+</span>
              <h3>Más proyectos<br /><em>próximamente.</em></h3>
              <p>Estamos preparando lo que sigue.</p>
            </article>
          </div>
          <p class="empty-state" id="empty-state" hidden>No encontramos proyectos con esa búsqueda.</p>
        </section>

      </main>

      <footer class="site-footer"><span>© {new Date().getFullYear()} MateLogic</span><span>Hecho con curiosidad y código abierto.</span><a href="https://github.com/Mate-Logic" target="_blank" rel="noreferrer">github.com/Mate-Logic ↗</a></footer>
    </div>

    <script>
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('.project-card');
      const search = document.querySelector('#project-search');
      const empty = document.querySelector('#empty-state');

      function filterProjects() {
        const active = document.querySelector('[data-filter].list-active')?.getAttribute('data-filter') || 'Todos';
        const query = search.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach((card) => {
          const matchesCategory = active === 'Todos' || card.getAttribute('data-category') === active;
          const matchesQuery = card.getAttribute('data-name')?.includes(query);
          const show = matchesCategory && matchesQuery;
          card.toggleAttribute('hidden', !show);
          if (show) visible += 1;
        });
        empty.toggleAttribute('hidden', visible !== 0);
      }

      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('list-active'));
        button.classList.add('list-active');
        filterProjects();
      }));
      search.addEventListener('input', filterProjects);
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) { event.preventDefault(); search.focus(); }
      });
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f1ecec; color: #211e1e; font-family: 'Manrope', sans-serif; }
  :global(body)::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .035; background-image: radial-gradient(#ffffff 0.5px, transparent 0.5px); background-size: 5px 5px; z-index: 4; }
  .page-shell { max-width: 1440px; margin: auto; padding: 0 5.5vw; overflow: hidden; }
  .site-header { height: 86px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #c9c1c1; font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .02em; }
  .brand { display: flex; align-items: center; gap: 11px; color: #211e1e; text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #f1ecec; background: #211e1e; font: 800 1rem 'Manrope', sans-serif; letter-spacing: -.12em; }
  .brand-mark span { font-size: .62rem; align-self: start; margin-top: 3px; }
  .brand-muted { color: #8c8282; }
  .site-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 46px); }
  .site-nav a { color: #6e6666; text-decoration: none; transition: color .2s; } .site-nav a:hover { color: #211e1e; }
  .site-nav .github-link { color: #211e1e; border-bottom: 1px solid #211e1e; padding-bottom: 3px; }
  .hero { min-height: 610px; display: grid; grid-template-columns: 1fr; place-items: center; text-align: center; border-bottom: 1px solid #c9c1c1; position: relative; background-image: linear-gradient(#ded6d6 1px, transparent 1px), linear-gradient(90deg, #ded6d6 1px, transparent 1px); background-size: 45px 45px; }
  .eyebrow, .section-kicker, .art-label, .card-category, .status, .project-count, .repo-slug { font: 500 .66rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { color: #6e6666; display: flex; gap: 9px; align-items: center; justify-content: center; }
  .pulse { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #211e1e; box-shadow: 0 0 0 4px #211e1e22; }
  h1, h2, h3, p { margin-top: 0; } h1 { margin: 25px 0 22px; font-size: clamp(3.5rem, 7vw, 6.8rem); letter-spacing: -.08em; line-height: .91; font-weight: 700; } h1 em, h2 em, .coming-card em { color: #c9f269; font-style: normal; }
  .hero-text { max-width: 530px; margin: auto; color: #6e6666; line-height: 1.7; font-size: .95rem; } .hero-text strong { color: #211e1e; font-weight: 600; }
  .hero-action { display: inline-flex; gap: 30px; margin-top: 27px; padding: 14px 17px; color: #f1ecec; background: #211e1e; font: 500 .7rem 'DM Mono', monospace; text-decoration: none; text-transform: uppercase; transition: transform .2s; } .hero-action:hover { transform: translateY(-3px); }
  .hero-art { position: absolute; width: min(37vw, 450px); aspect-ratio: 1; opacity: .16; z-index: 0; }
  .hero-copy { position: relative; z-index: 1; }
  .orbit { position: absolute; border: 1px solid #211e1e; border-radius: 50%; transform: rotate(-28deg); } .orbit-one { inset: 10% 0; } .orbit-two { inset: 0 18%; transform: rotate(58deg); border-color: #211e1e; }
  .orbit-core { position: absolute; inset: 33%; display: grid; place-items: center; background: #211e1e; color: #f1ecec; border-radius: 50%; font-size: clamp(3rem, 7vw, 6rem); font-weight: 800; letter-spacing: -.15em; } .orbit-core span { transform: translateX(-5px); }
  .art-label { position: absolute; color: #211e1e; line-height: 1.5; } .label-top { top: 4%; right: 5%; } .label-bottom { bottom: 3%; left: 5%; color: #211e1e; }
  .directory { padding: 95px 0 120px; } .section-heading { display: flex; justify-content: space-between; align-items: end; } .section-kicker { color: #8b8080; margin-bottom: 18px; } h2 { font-size: clamp(2rem, 4vw, 3.7rem); letter-spacing: -.07em; line-height: 1; margin-bottom: 0; } .project-count { color: #8b8080; margin: 0; } .project-count span { color: #211e1e; font-size: 1.2rem; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 55px 0 25px; padding-bottom: 15px; border-bottom: 1px solid #2d302b; } .filters { display: flex; flex-wrap: wrap; gap: 7px; } .filters button { border: 1px solid transparent; padding: 8px 13px; color: #858b80; background: transparent; font: .68rem 'DM Mono', monospace; cursor: pointer; } .filters button:hover, .filters .list-active { color: #c9f269; border-color: #4a523e; background: #1c2118; }
  .search-box { display: flex; align-items: center; gap: 9px; width: 200px; padding: 8px 10px; border: 1px solid #353a32; color: #72786e; font-family: 'DM Mono', monospace; } .search-box input { min-width: 0; width: 100%; border: 0; outline: 0; color: #e9e9e2; background: transparent; font: .68rem 'DM Mono', monospace; } .search-box input::placeholder { color: #72786e; } kbd { padding: 2px 5px; border: 1px solid #41463c; font-size: .58rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; } .project-card, .coming-card { min-height: 290px; display: flex; flex-direction: column; padding: 24px; border: 1px solid #343930; background: #161814; transition: border-color .2s, transform .2s; } .project-card:hover { border-color: #c9f269; transform: translateY(-4px); } .project-card[hidden] { display: none; } .project-card.list-featured { grid-column: span 2; min-height: 320px; background: linear-gradient(110deg, #1a2116, #161814 65%); border-color: #4b593a; }
  .card-topline, .card-footer { display: flex; justify-content: space-between; align-items: center; } .project-icon { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #566647; color: #c9f269; font-weight: 700; } .status { color: #c9f269; } .status i { display: inline-block; width: 5px; height: 5px; margin: 0 7px 2px 0; border-radius: 50%; background: #c9f269; }
  .card-content { margin: auto 0 31px; } .card-category { color: #888e83; } .card-category span { color: #c9f269; } .card-content h3 { margin: 12px 0 8px; font-size: 1.55rem; letter-spacing: -.06em; } .card-content p:not(.card-category) { max-width: 480px; margin-bottom: 0; color: #92988d; font-size: .86rem; line-height: 1.55; } .card-footer { padding-top: 17px; border-top: 1px solid #30352d; } .repo-slug { color: #687064; font-size: .58rem; } .card-footer a { color: #dce2d3; font: .65rem 'DM Mono', monospace; text-decoration: none; } .card-footer a:hover { color: #c9f269; }
  .coming-card { justify-content: center; border-style: dashed; color: #848a7e; } .plus-icon { color: #c9f269; font-size: 2rem; line-height: 1; } .coming-card h3 { margin: 24px 0 10px; font-size: 1.7rem; letter-spacing: -.07em; } .coming-card p { margin: 0; font: .68rem 'DM Mono', monospace; } .empty-state { padding: 50px; color: #92988d; text-align: center; font: .75rem 'DM Mono', monospace; }
  .about { padding: 90px 0 110px; border-top: 1px solid #2d302b; } .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; } .about-content p { max-width: 430px; margin-top: 8px; color: #92988d; font-size: 1rem; line-height: 1.8; }
  .site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0 28px; border-top: 1px solid #2d302b; color: #687064; font: .62rem 'DM Mono', monospace; } .site-footer a { color: #c9f269; text-decoration: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .directory { background: #f1ecec; }
  h1 em, h2 em { color: #6e6666; }
  .toolbar { border-color: #c9c1c1; }
  .filters button { color: #827878; } .filters button:hover, .filters .list-active { color: #211e1e; border-color: #211e1e; background: transparent; }
  .search-box { border-color: #bdb4b4; color: #827878; } .search-box input { color: #211e1e; } .search-box input::placeholder { color: #827878; } kbd { border-color: #bdb4b4; }
  .project-card, .coming-card { border-color: #393434; background: #211e1e; } .project-card:hover { border-color: #211e1e; } .project-card.list-featured { background: #211e1e; border-color: #211e1e; }
  .project-icon { border-color: #6f6868; color: #f1ecec; } .status { color: #f1ecec; } .status i { background: #f1ecec; }
  .card-category, .repo-slug { color: #a79e9e; } .card-category span { color: #f1ecec; } .card-content p:not(.card-category) { color: #b8b0b0; } .card-footer { border-color: #4a4444; } .card-footer a { color: #f1ecec; } .card-footer a:hover { color: #c9c1c1; }
  .plus-icon, .coming-card em { color: #f1ecec; } .coming-card { border-color: #a79e9e; color: #b8b0b0; }
  .about { border-color: #c9c1c1; } .about-content p { color: #6e6666; } .site-footer { border-color: #c9c1c1; color: #8b8080; } .site-footer a { color: #211e1e; }
  /* OpenCode-inspired dark palette: quiet surfaces, warm grays, no decoration. */
  :global(body) { background: #211e1e; color: #f1ecec; }
  :global(body)::before { display: none; }
  .page-shell { max-width: 1240px; }
  .site-header { border-color: #4b4646; }
  .brand { color: #f1ecec; font: 500 .82rem 'DM Mono', monospace; letter-spacing: -.02em; }
  .brand span { color: #b7b1b1; }
  .site-nav a { color: #b7b1b1; } .site-nav a:hover, .site-nav .github-link { color: #f1ecec; }
  .site-nav .github-link { border-color: #b7b1b1; }
  .hero { min-height: 500px; border-color: #4b4646; background: none; }
  .eyebrow { color: #b7b1b1; }
  .pulse { background: #b7b1b1; box-shadow: none; }
  h1 { font-size: clamp(3.25rem, 7vw, 6.4rem); font-weight: 500; letter-spacing: -.09em; }
  h1 em, h2 em { color: #b7b1b1; }
  .hero-text { color: #b7b1b1; }
  .hero-text strong { color: #f1ecec; }
  .directory { background: #211e1e; padding-top: 82px; }
  .section-kicker, .project-count { color: #807a7a; }
  .project-count span { color: #f1ecec; }
  .toolbar { border-color: #4b4646; }
  .filters button { color: #b7b1b1; } .filters button:hover, .filters .list-active { color: #f1ecec; border-color: #807a7a; background: #2d2929; }
  .search-box { border-color: #4b4646; color: #807a7a; } .search-box input { color: #f1ecec; } .search-box input::placeholder { color: #807a7a; } kbd { border-color: #4b4646; }
  .project-card, .coming-card, .project-card.list-featured { border-color: #4b4646; background: #2b2727; }
  .project-card:hover { border-color: #b7b1b1; transform: translateY(-2px); }
  .project-card.list-featured { min-height: 290px; }
  .project-icon { border-color: #807a7a; color: #f1ecec; } .status { color: #b7b1b1; } .status i { background: #b7b1b1; }
  .card-category, .repo-slug { color: #807a7a; } .card-category span { color: #b7b1b1; } .card-content p:not(.card-category) { color: #b7b1b1; } .card-footer { border-color: #4b4646; } .card-footer a { display: inline-flex; align-items: center; gap: 7px; color: #f1ecec; } .card-footer a:hover { color: #b7b1b1; } .card-footer svg { width: 15px; height: 15px; fill: currentColor; }
  .coming-card { border-style: dashed; color: #807a7a; } .plus-icon, .coming-card em { color: #b7b1b1; }
  .about { border-color: #4b4646; } .about-content p { color: #b7b1b1; } .site-footer { border-color: #4b4646; color: #807a7a; } .site-footer a { color: #b7b1b1; }
  @media (max-width: 700px) { .page-shell { padding: 0 20px; } .site-header { height: 75px; } .site-nav a:not(.github-link) { display: none; } .hero { display: block; min-height: auto; padding: 75px 0 80px; } h1 { font-size: clamp(3.2rem, 15vw, 5rem); } .hero-art { width: 78vw; max-width: 360px; margin: 70px auto 0; } .section-heading, .toolbar, .about-content { display: block; } .project-count { margin-top: 20px; } .toolbar { margin-top: 38px; } .search-box { margin-top: 17px; width: 100%; } .project-grid { display: block; } .project-card, .coming-card, .project-card.list-featured { min-height: 280px; margin-bottom: 14px; } .site-footer { flex-wrap: wrap; } }
</style>
