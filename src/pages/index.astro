---
const projects = [
  {
    name: 'Open Source Directory',
    slug: 'opensource-directory',
    description: 'El punto de encuentro para descubrir todo lo que construimos en abierto.',
    category: 'Web',
    language: 'Astro',
    status: 'En desarrollo',
    href: 'https://github.com/Mate-Logic/opensource-directory',
    featured: true,
  },
];

const categories = ['Todos', 'Web', 'Herramientas', 'CLI', 'Librerías'];
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Directorio de proyectos open source creados por MateLogic." />
    <meta name="theme-color" content="#10110f" />
    <title>MateLogic Open Source</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={base} aria-label="MateLogic Open Source, inicio">
          <span class="brand-mark">M<span>+</span></span>
          <span>MateLogic<span class="brand-muted">/open-source</span></span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#sobre-nosotros">Sobre nosotros</a>
          <a class="github-link" href="https://github.com/Mate-Logic" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="pulse"></span> Código abierto, ideas compartidas</p>
            <h1 id="hero-title">Software que merece<br /><em>ser compartido.</em></h1>
            <p class="hero-text">Un directorio de herramientas, experimentos y productos open source creados por <strong>MateLogic</strong>.</p>
            <a class="hero-action" href="#proyectos">Explorar proyectos <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit-core"><span>M</span></div>
            <div class="art-label label-top">BUILD IN PUBLIC</div>
            <div class="art-label label-bottom">BUENAS IDEAS<br />NO TIENEN DUEÑO</div>
          </div>
        </section>

        <section class="directory" id="proyectos" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <p class="section-kicker">01 / El directorio</p>
              <h2 id="projects-title">Nuestros proyectos</h2>
            </div>
            <p class="project-count"><span>{projects.length.toString().padStart(2, '0')}</span> proyectos publicados</p>
          </div>

          <div class="toolbar">
            <div class="filters" aria-label="Filtrar proyectos">
              {categories.map((category, index) => <button class:list-active={index === 0} data-filter={category}>{category}</button>)}
            </div>
            <label class="search-box">
              <span class="search-icon" aria-hidden="true">⌕</span>
              <span class="sr-only">Buscar proyectos</span>
              <input type="search" placeholder="Buscar proyecto..." id="project-search" />
              <kbd>/</kbd>
            </label>
          </div>

          <div class="project-grid" id="project-grid">
            {projects.map((project) => (
              <article class:list-featured={project.featured} class="project-card" data-category={project.category} data-name={project.name.toLowerCase()}>
                <div class="card-topline"><span class="project-icon">{project.name.slice(0, 1)}</span><span class="status"><i></i>{project.status}</span></div>
                <div class="card-content">
                  <p class="card-category">{project.category} <span>/</span> {project.language}</p>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
                <div class="card-footer">
                  <span class="repo-slug">Mate-Logic / {project.slug}</span>
                  <a href={project.href} target="_blank" rel="noreferrer" aria-label={`Ver ${project.name} en GitHub`}>Ver repositorio <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
            <article class="coming-card">
              <span class="plus-icon">+</span>
              <h3>Más proyectos<br /><em>próximamente.</em></h3>
              <p>Estamos preparando lo que sigue.</p>
            </article>
          </div>
          <p class="empty-state" id="empty-state" hidden>No encontramos proyectos con esa búsqueda.</p>
        </section>

        <section class="about" id="sobre-nosotros">
          <p class="section-kicker">02 / La idea</p>
          <div class="about-content"><h2>Construir mejor,<br /><em>juntos.</em></h2><p>MateLogic es un laboratorio independiente. Abrimos nuestro código para que las ideas puedan viajar, mejorar y llegar más lejos que nosotros.</p></div>
        </section>
      </main>

      <footer class="site-footer"><span>© {new Date().getFullYear()} MateLogic</span><span>Hecho con curiosidad y código abierto.</span><a href="https://github.com/Mate-Logic" target="_blank" rel="noreferrer">github.com/Mate-Logic ↗</a></footer>
    </div>

    <script>
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('.project-card');
      const search = document.querySelector('#project-search');
      const empty = document.querySelector('#empty-state');

      function filterProjects() {
        const active = document.querySelector('[data-filter].list-active')?.getAttribute('data-filter') || 'Todos';
        const query = search.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach((card) => {
          const matchesCategory = active === 'Todos' || card.getAttribute('data-category') === active;
          const matchesQuery = card.getAttribute('data-name')?.includes(query);
          const show = matchesCategory && matchesQuery;
          card.toggleAttribute('hidden', !show);
          if (show) visible += 1;
        });
        empty.toggleAttribute('hidden', visible !== 0);
      }

      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('list-active'));
        button.classList.add('list-active');
        filterProjects();
      }));
      search.addEventListener('input', filterProjects);
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) { event.preventDefault(); search.focus(); }
      });
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #10110f; color: #e9e9e2; font-family: 'Manrope', sans-serif; }
  :global(body)::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .035; background-image: radial-gradient(#ffffff 0.5px, transparent 0.5px); background-size: 5px 5px; z-index: 4; }
  .page-shell { max-width: 1440px; margin: auto; padding: 0 5.5vw; overflow: hidden; }
  .site-header { height: 92px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #2d302b; font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .02em; }
  .brand { display: flex; align-items: center; gap: 11px; color: #f4f4ec; text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #10110f; background: #c9f269; font: 800 1rem 'Manrope', sans-serif; letter-spacing: -.12em; }
  .brand-mark span { font-size: .62rem; align-self: start; margin-top: 3px; }
  .brand-muted { color: #73786f; }
  .site-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 46px); }
  .site-nav a { color: #9da198; text-decoration: none; transition: color .2s; } .site-nav a:hover { color: #c9f269; }
  .site-nav .github-link { color: #e9e9e2; border-bottom: 1px solid #c9f269; padding-bottom: 3px; }
  .hero { min-height: 560px; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; border-bottom: 1px solid #2d302b; }
  .eyebrow, .section-kicker, .art-label, .card-category, .status, .project-count, .repo-slug { font: 500 .66rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { color: #c9f269; display: flex; gap: 9px; align-items: center; }
  .pulse { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #c9f269; box-shadow: 0 0 0 4px #c9f26922; }
  h1, h2, h3, p { margin-top: 0; } h1 { margin: 25px 0 22px; font-size: clamp(3.5rem, 7vw, 6.8rem); letter-spacing: -.08em; line-height: .91; font-weight: 700; } h1 em, h2 em, .coming-card em { color: #c9f269; font-style: normal; }
  .hero-text { max-width: 430px; color: #989d93; line-height: 1.7; font-size: .95rem; } .hero-text strong { color: #e9e9e2; font-weight: 600; }
  .hero-action { display: inline-flex; gap: 30px; margin-top: 23px; padding: 13px 16px; color: #10110f; background: #c9f269; font: 500 .7rem 'DM Mono', monospace; text-decoration: none; text-transform: uppercase; transition: transform .2s; } .hero-action:hover { transform: translateY(-3px); }
  .hero-art { position: relative; width: min(37vw, 450px); aspect-ratio: 1; justify-self: end; }
  .orbit { position: absolute; border: 1px solid #3a3e36; border-radius: 50%; transform: rotate(-28deg); } .orbit-one { inset: 10% 0; } .orbit-two { inset: 0 18%; transform: rotate(58deg); border-color: #4d523f; }
  .orbit-core { position: absolute; inset: 33%; display: grid; place-items: center; background: #c9f269; color: #10110f; border-radius: 50%; font-size: clamp(3rem, 7vw, 6rem); font-weight: 800; letter-spacing: -.15em; box-shadow: 0 0 65px #c9f26930; } .orbit-core span { transform: translateX(-5px); }
  .art-label { position: absolute; color: #6e7469; line-height: 1.5; } .label-top { top: 4%; right: 5%; } .label-bottom { bottom: 3%; left: 5%; color: #c9f269; }
  .directory { padding: 95px 0 120px; } .section-heading { display: flex; justify-content: space-between; align-items: end; } .section-kicker { color: #747a70; margin-bottom: 18px; } h2 { font-size: clamp(2rem, 4vw, 3.7rem); letter-spacing: -.07em; line-height: 1; margin-bottom: 0; } .project-count { color: #73786f; margin: 0; } .project-count span { color: #c9f269; font-size: 1.2rem; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 55px 0 25px; padding-bottom: 15px; border-bottom: 1px solid #2d302b; } .filters { display: flex; flex-wrap: wrap; gap: 7px; } .filters button { border: 1px solid transparent; padding: 8px 13px; color: #858b80; background: transparent; font: .68rem 'DM Mono', monospace; cursor: pointer; } .filters button:hover, .filters .list-active { color: #c9f269; border-color: #4a523e; background: #1c2118; }
  .search-box { display: flex; align-items: center; gap: 9px; width: 200px; padding: 8px 10px; border: 1px solid #353a32; color: #72786e; font-family: 'DM Mono', monospace; } .search-box input { min-width: 0; width: 100%; border: 0; outline: 0; color: #e9e9e2; background: transparent; font: .68rem 'DM Mono', monospace; } .search-box input::placeholder { color: #72786e; } kbd { padding: 2px 5px; border: 1px solid #41463c; font-size: .58rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; } .project-card, .coming-card { min-height: 290px; display: flex; flex-direction: column; padding: 24px; border: 1px solid #343930; background: #161814; transition: border-color .2s, transform .2s; } .project-card:hover { border-color: #c9f269; transform: translateY(-4px); } .project-card[hidden] { display: none; } .project-card.list-featured { grid-column: span 2; min-height: 320px; background: linear-gradient(110deg, #1a2116, #161814 65%); border-color: #4b593a; }
  .card-topline, .card-footer { display: flex; justify-content: space-between; align-items: center; } .project-icon { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #566647; color: #c9f269; font-weight: 700; } .status { color: #c9f269; } .status i { display: inline-block; width: 5px; height: 5px; margin: 0 7px 2px 0; border-radius: 50%; background: #c9f269; }
  .card-content { margin: auto 0 31px; } .card-category { color: #888e83; } .card-category span { color: #c9f269; } .card-content h3 { margin: 12px 0 8px; font-size: 1.55rem; letter-spacing: -.06em; } .card-content p:not(.card-category) { max-width: 480px; margin-bottom: 0; color: #92988d; font-size: .86rem; line-height: 1.55; } .card-footer { padding-top: 17px; border-top: 1px solid #30352d; } .repo-slug { color: #687064; font-size: .58rem; } .card-footer a { color: #dce2d3; font: .65rem 'DM Mono', monospace; text-decoration: none; } .card-footer a:hover { color: #c9f269; }
  .coming-card { justify-content: center; border-style: dashed; color: #848a7e; } .plus-icon { color: #c9f269; font-size: 2rem; line-height: 1; } .coming-card h3 { margin: 24px 0 10px; font-size: 1.7rem; letter-spacing: -.07em; } .coming-card p { margin: 0; font: .68rem 'DM Mono', monospace; } .empty-state { padding: 50px; color: #92988d; text-align: center; font: .75rem 'DM Mono', monospace; }
  .about { padding: 90px 0 110px; border-top: 1px solid #2d302b; } .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; } .about-content p { max-width: 430px; margin-top: 8px; color: #92988d; font-size: 1rem; line-height: 1.8; }
  .site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0 28px; border-top: 1px solid #2d302b; color: #687064; font: .62rem 'DM Mono', monospace; } .site-footer a { color: #c9f269; text-decoration: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 700px) { .page-shell { padding: 0 20px; } .site-header { height: 75px; } .site-nav a:not(.github-link) { display: none; } .hero { display: block; min-height: auto; padding: 75px 0 80px; } h1 { font-size: clamp(3.2rem, 15vw, 5rem); } .hero-art { width: 78vw; max-width: 360px; margin: 70px auto 0; } .section-heading, .toolbar, .about-content { display: block; } .project-count { margin-top: 20px; } .toolbar { margin-top: 38px; } .search-box { margin-top: 17px; width: 100%; } .project-grid { display: block; } .project-card, .coming-card, .project-card.list-featured { min-height: 280px; margin-bottom: 14px; } .site-footer { flex-wrap: wrap; } }
</style>
